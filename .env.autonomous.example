# Milvus 宿主机访问端口为 29531；业务容器仍使用 milvus-aiops:19530。
AIOPS_DB_PASSWORD=aiops-local-password
AIOPS_RABBIT_PASSWORD=aiops-local-password
AIOPS_REDIS_PASSWORD=aiops-local-password
AIOPS_EXECUTOR_KEY_ID=control-plane-01
AIOPS_EXECUTOR_SHARED_SECRET=aiops-local-executor-secret-2026
AIOPS_API_KEY=
AIOPS_SECURITY_ENABLED=false
AIOPS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AIOPS_MONITOR_ENABLED=true
AIOPS_MONITOR_INTERVAL_MS=30000
AIOPS_MONITOR_FAILURE_THRESHOLD=3
DASHSCOPE_API_KEY=demo-placeholder-key
SPRING_AI_MCP_CLIENT_ENABLED=false
PROMETHEUS_BASE_URL=http://prometheus-aiops:9090
AIOPS_EMAIL_ENABLED=false
AIOPS_EMAIL_FROM=aiops@example.com
AIOPS_EMAIL_TO=ops@example.com
AIOPS_EMAIL_SUBJECT_PREFIX=[AIOps]
AIOPS_EMAIL_RETRY_ATTEMPTS=3
AIOPS_EMAIL_RETRY_DELAY_MS=1000
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_SSL_ENABLE=true
SMTP_STARTTLS=false
DEMO_TOKEN=local-demo-token
GRAFANA_PASSWORD=replace-with-a-local-password
